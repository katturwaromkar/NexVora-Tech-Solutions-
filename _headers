# Cloudflare Pages Global Security & Edge Performance Headers
# =============================================================

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://*.razorpay.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://*.razorpay.com; frame-src 'self' https://www.google.com https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com; connect-src 'self' https://wa.me https://api.whatsapp.com https://api.razorpay.com https://lumberjack.razorpay.com https://lumberjack-cx.razorpay.com https://*.razorpay.com;
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Robots-Tag: all

# Cloudflare Edge Cache for Static Assets (Images, Icons, Brochures)
/assets/*
  Cache-Control: public, max-age=2592000, immutable

# Cloudflare Edge Cache for Stylesheets & JavaScript
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
